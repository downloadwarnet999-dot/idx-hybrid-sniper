# Streamlit Secrets Configuration Template
# Copy this file to secrets.toml and fill in your actual credentials
# NEVER commit secrets.toml to git!

# Database Configuration
[database]
# For local development, leave type as sqlite
# For cloud deployment, set to postgresql and provide connection URL
type = "sqlite"  # or "postgresql" for cloud

# PostgreSQL connection string (only needed for cloud deployment)
# Get this from your Supabase project: Settings → Database → Connection String (URI)
# Format: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# url = "postgresql://postgres:your_password@db.xxxxx.supabase.co:5432/postgres"

# Telegram Bot Configuration (Optional)
[telegram]
# Get bot token from @BotFather on Telegram
# bot_token = "123456789:ABCdefGHIjklMNOpqrsTUVwxyz"

# Get chat_id by messaging @userinfobot
# chat_id = "123456789"
